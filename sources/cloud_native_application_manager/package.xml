<?xml version="1.0"?>
<package format="3">
  <name>cloud_native_application_manager</name>
  <version>0.1.0</version>
  <description>Fleet-level policy control loop and KubeROS adapter.</description>
  <maintainer email="research@cloud-native-robotics.local">Cloud Native ROS Kubernetes Project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>cloud_native_robotics_interfaces</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
