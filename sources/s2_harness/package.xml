<?xml version="1.0"?>
<package format="3">
  <name>s2_harness</name>
  <version>0.1.0</version>
  <description>S2 test harness on drone01's node: local recorder of the analytics metrics and transient injector (R11).</description>
  <maintainer email="research@cloud-native-robotics.local">Cloud Native ROS Kubernetes Project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>cloud_native_robotics_interfaces</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
