<?xml version="1.0"?>
<package format="3">
  <name>state_bridge</name>
  <version>0.1.0</version>
  <description>Mirrors a ROS 2 Lifecycle node's state into its ROSModule custom resource, and applies declared lifecycle transitions back onto it.</description>
  <maintainer email="research@cloud-native-robotics.local">Cloud Native ROS Kubernetes Project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>cloud_native_robotics_interfaces</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
